{
  "user_agent": "OutreachTools/1.0",
  "vault": "./data",
  "sources": {
    "comptroller_texas": {
      "kind": "soda",
      "url": "https://data.texas.gov/resource/jrea-zgmq.json",
      "params": {
        "$limit": "50000",
        "$where": "outlet_naics_code >= 541100 AND outlet_naics_code < 541200 AND upper(outlet_state)='TX'",
        "$order": "outlet_name"
      },
      "notes": "Texas Comptroller Active Sales Tax Permit Holders (jrea-zgmq). Statewide. Legal-services NAICS."
    },
    "tdlr": {
      "kind": "soda",
      "url": "https://data.texas.gov/resource/7358-krk7.json",
      "params": {
        "$limit": "50000",
        "$where": "upper(license_type) is not null",
        "$order": "business_name"
      },
      "notes": "TDLR All Licenses. Filter license_type in the parser. Statewide Texas."
    },
    "osm_lawyers": {
      "kind": "overpass",
      "url": "https://overpass-api.de/api/interpreter",
      "data": "[out:json][timeout:180];area[\"ISO3166-2\"=\"US-TX\"]->.a;(node[\"office\"=\"lawyer\"](area.a);way[\"office\"=\"lawyer\"](area.a););out center tags;"
    },
    "justia_pi_texas": {
      "kind": "html",
      "url": "https://www.justia.com/lawyers/personal-injury/texas",
      "parse": [
        "jsonld_LegalService",
        "ProfileWebsite",
        "rel=me"
      ],
      "website_field_from": [
        "ProfileWebsite",
        "rel=me"
      ]
    },
    "justia_pi_texas_p2": {
      "kind": "html",
      "url": "https://www.justia.com/lawyers/personal-injury/texas?page=2",
      "parse": [
