        "ProfileWebsite",
        "rel=me"
      ]
    },
    "findlaw_pi_texas": {
      "kind": "html",
      "url": "https://lawyers.findlaw.com/lawyer/firm/personal-injury-plaintiff/houston/texas",
      "parse": [
        "Visit Website",
        "website-button-link"
      ],
      "notes": "FindLaw city pages are metro-scoped. Houston is a Texas example; override --recipes for another city."
    },
    "fmcsa_census": {
      "kind": "soda",
      "url": "https://data.transportation.gov/resource/az4n-8mr2.json",
      "params": {
        "$limit": "50000",
        "$where": "upper(phy_state)='TX' OR upper(mailing_state)='TX'",
        "$order": "legal_name"
      }
    },
