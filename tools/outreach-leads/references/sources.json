      "data": "[out:json][timeout:180];area[\"ISO3166-2\"=\"US-TX\"]->.a;(node[\"shop\"](area.a);node[\"craft\"~\"electrician|plumber|hvac\"](area.a);node[\"office\"~\"lawyer|accountant|estate_agent\"](area.a););out center tags;"
